{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "dev:https": "cross-env VITE_HTTPS=true vite --port 3443 --host 0.0.0.0",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:d1": "wrangler pages dev dist --d1=attendance-db --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name attendance-system",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply attendance-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply attendance-db --remote",
    "db:seed": "wrangler d1 execute attendance-db --local --file=./seed.sql",
    "db:seed:auth": "wrangler d1 execute attendance-db --local --file=./seed_auth.sql",
    "db:console:local": "wrangler d1 execute attendance-db --local",
    "db:console:prod": "wrangler d1 execute attendance-db",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "git:init": "git init && git add . && git commit -m 'Initial commit'",
    "git:commit": "git add . && git commit -m",
    "git:status": "git status",
    "git:log": "git log --oneline"
  },
  "dependencies": {
    "hono": "^4.10.6",
    "jose": "^6.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250705.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "cross-env": "^10.1.0",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
